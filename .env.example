# Get a key: https://app.rpcedge.com/signup
# Prove it:   npx rpcedge@latest doctor   (or pnpm doctor)
RPCEDGE_KEY=

# Wallet to watch (default = high-activity pump.fun-era example for demos only - see README)
WATCH_WALLET=bwamJzztZsepfkteWRChggmXuiiCQvpLqPietdNfSXa

# paper = log only (default). live = never auto-enabled without LIVE_SUBMIT=1
MODE=paper

# Only if MODE=live AND you intentionally enable submission of YOUR signed txs
LIVE_SUBMIT=0

# Poll interval / limit only used when HISTORY_RPC_URL is set
POLL_MS=2000
POLL_LIMIT=15

# Optional archive/indexer RPC for getSignaturesForAddress (not the edge node)
# HISTORY_RPC_URL=https://api.mainnet-beta.solana.com
