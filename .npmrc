# optional native deps for ws; not required for paper path
strict-peer-dependencies=false

# Our packages publish same-day as this ref; global/user minimumReleaseAge
# would otherwise block pnpm install (ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION).
minimum-release-age-exclude[]=rpcedge-core
minimum-release-age-exclude[]=rpcedge-sdk
minimum-release-age-exclude[]=rpcedge
minimum-release-age-exclude[]=rpcedge-mcp
